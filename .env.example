# 复制为 .env 并填写。程序只通过环境变量读取，仓库不保存真实值。
# FRED API 密钥（可选）。本机直连 fred.stlouisfed.org 的 CSV 接口被拦截，高收益利差等 FRED 独有序列需要 API 密钥。
FRED_API_KEY=
# Tushare 令牌（可选，第 2 阶段用于上金所与上期所数据）
TUSHARE_TOKEN=
# 飞书群机器人 webhook（第 3 阶段推送）
FEISHU_WEBHOOK_URL=
# 发布：每日运行后提交 site/ 并推送到远端；默认开启（存在 origin 时），填 0 关闭
GOLD_PUBLISH_PUSH=1
GOLD_GIT_REMOTE=origin
GOLD_GIT_BRANCH=main
